{
  "permissions": {
    "allow": [
      "Bash(gh auth *)",
      "Bash(gh --version)",
      "Bash(echo \"exit:$?\")",
      "Bash(git config *)",
      "Bash(echo \"name=[$\\(git config user.name\\)]\")",
      "Bash(echo \"email=[$\\(git config user.email\\)]\")",
      "Bash(echo \"global-name=[$\\(git config --global user.name\\)]\")",
      "Bash(echo \"global-email=[$\\(git config --global user.email\\)]\")",
      "Bash(git commit -m ' *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git ls-tree *)"
    ]
  }
}
